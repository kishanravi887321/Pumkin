MONGO__DB__URL=mongodb+srv://<username>:<password>@<cluster>/
MONGO__DB__NAME=pumkin
PORT=8080
ENV=development

NEON_DB_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRY=360h
REFRESH_TOKEN_EXPIRY=720h
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

PRIVATE_SERVER_URL=http://
PRIVATE_SERVER_AUTH_TOKEN=your_private_server_auth_token
MASTER__KEY=your_master_key